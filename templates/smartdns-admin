                          html.escape(scope_text("dns_forwards", r["domain"])), "".join(cells),
                          html.escape(r["note"] or ""), p, html.escape(r["domain"])))
        out.append("</table>")
    out.append("<p class='muted'>این دامنه و همهٔ زیردامنه‌هایش برای مشتری‌های قالب‌های "
