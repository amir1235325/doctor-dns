            out.append("<p class='muted'>جوابی از سرورهای ایران نیامد. سرور ایران باید "
                       "روی نسخهٔ تازه باشد.</p>")
        if waiting:
            out.append("<script>setTimeout(function(){location.reload()},15000)</script>")
    out.append("</div>")
    return "".join(out)

