        if not res["ok"]:
            return {"too_big": 413, "plan_not_on_sale": 409}.get(res["error"], 400), res
        return 201, {"ok": True, "message": res["message"],
                     "receipt": self.receipt(res["receipt_id"])}

    def api_credentials(self, body, tg):
        user, err = self.customer(tg)
