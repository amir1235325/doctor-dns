def main():
    global CATALOGUE
    cfg = load_config()
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    store = Store(DB)
    CATALOGUE = load_catalogue() + [CUSTOM_SERVICE]
    GAMES[:] = load_games()
    follow_catalogue_split(store, CATALOGUE)
