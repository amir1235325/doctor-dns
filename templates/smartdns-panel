                             (user["id"], ip))
        if not cur.rowcount:
            return 404, refused("ip_not_found", "این آی‌پی روی این حساب نیست")
        return 200, {"ok": True, "message": "آی‌پی %s حذف شد" % ip,
                     "user": user_view(self.store, user, self.relays)}

