            return 400, refused("bad_ip", "آی‌پی نامعتبر است؛ آی‌پی عمومی اینترنت "
                                          "مشتری لازم است")
        res = register_ip(self.store, user["id"], ip)
        if not res["ok"]:
            return 409, res
        return 200, {"ok": True, "message": res["message"],
                     "user": user_view(self.store, user, self.relays)}

